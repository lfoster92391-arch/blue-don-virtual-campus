  FINAL
  POSTPONED
  CANCELED
}

enum SportsGameResult {
  WIN
  LOSS
  TIE
}

model SportsGame {
  id             String             @id @default(cuid())
  sportId        String             @map("sport_id")
  opponentId     String?            @map("opponent_id")
  opponentTeamId String?            @map("opponent_team_id")
  opponentLabel  String?            @map("opponent_label")
  kickoffAt      DateTime           @map("kickoff_at")
  site           SportsGameSite     @default(HOME)
