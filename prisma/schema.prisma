  status      ImpactProjectStatus @default(PROPOSAL)
  milestones  Json                @default("[]")
  advisorId   String?             @map("advisor_id") @db.Uuid
  completedAt DateTime?           @map("completed_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  student     User                @relation("ImpactProjectStudent", fields: [studentId], references: [id], onDelete: Cascade)
  advisor     User?               @relation("ImpactProjectAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([advisorId])
  @@map("impact_projects")
}

model GraduateLegacy {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id") @db.Uuid
  slug           String   @unique
  classYear      Int      @map("class_year")
  organizations  Json     @default("[]")
  achievements   Json     @default("[]")
  projects       Json     @default("[]")
