  updatedAt   DateTime           @updatedAt @map("updated_at")
  academy       Academy?           @relation(fields: [academyId], references: [id], onDelete: SetNull)
  memberships OrganizationMembership[]
  wishlistItems WishlistItem[]
  equipmentItems EquipmentItem[]
  campusMediaItems CampusMediaItem[]
  cornerStoreItems CornerStoreItem[]
  ledgerEntries ClubLedgerEntry[]
  fundraisers ClubFundraiser[]
  calendarEvents ClubCalendarEvent[]
  clubInvoices ClubInvoice[]
  cricutShopItems CricutShopItem[]
  cricutDesignSubmissions CricutDesignSubmission[]
  cricutProjectIdeas CricutProjectIdea[]
  broadcastScriptTemplate BroadcastScriptTemplate?
  broadcastDailyScripts BroadcastDailyScript[]
  clubDocuments ClubDocument[]
  clubProjects ClubProject[]
  clubProjectChecklists ClubProjectChecklist[]
  studentMessages StudentMessage[]
  clubStudentTasks ClubStudentTask[]
  broadcastSchedule BroadcastSchedule?
  broadcastBookingRequests BroadcastBookingRequest[]
  broadcastAnnouncementSubmissions BroadcastAnnouncementSubmission[]
  broadcastCrewCredits BroadcastCrewCredit[]
  broadcastEquipmentItems BroadcastEquipmentItem[]
  broadcastJoinApplications BroadcastJoinApplication[]

  @@index([type])
