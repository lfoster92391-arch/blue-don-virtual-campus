}

model ClubCalendarEvent {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  title             String
  description       String?
  location          String?
  startDate         DateTime     @map("start_date")
  endDate           DateTime     @map("end_date")
  /** IT all-hands: visible to every focus-club member, not only the host club. */
  mandatoryAllClubs Boolean      @default(false) @map("mandatory_all_clubs")
