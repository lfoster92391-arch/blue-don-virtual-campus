  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([classYear])
  @@map("graduate_legacies")
}

enum CampusMediaType {
  VIDEO_UPLOAD
  LIVE_STREAM
}

enum CampusMediaStatus {
  DRAFT
  PUBLISHED
  LIVE
  ENDED
}

model CampusMediaItem {
  id             String            @id @default(cuid())
  title          String
  description    String?
  type           CampusMediaType
  status         CampusMediaStatus @default(DRAFT)
  storagePath    String?           @map("storage_path")
  publicUrl      String?           @map("public_url")
  thumbnailUrl   String?           @map("thumbnail_url")
  embedUrl       String?           @map("embed_url")
  streamKey      String?           @map("stream_key")
  organizationId String?           @map("organization_id")
  uploadedById   String            @map("uploaded_by_id") @db.Uuid
  publishedAt    DateTime?         @map("published_at")
  endedAt        DateTime?         @map("ended_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  uploadedBy     User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
