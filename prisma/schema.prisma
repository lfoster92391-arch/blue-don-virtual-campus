  buyerId            String                 @map("buyer_id") @db.Uuid
  fulfillment        CricutFulfillmentMethod
  status             CricutShopOrderStatus  @default(PENDING)
  subtotalCents      Int                    @map("subtotal_cents")
  shippingCents      Int                    @default(0) @map("shipping_cents")
  totalCents         Int                    @map("total_cents")
  contactName        String?                @map("contact_name")
  contactEmail       String?                @map("contact_email")
  contactPhone       String?                @map("contact_phone")
  customizationNotes String?                @map("customization_notes")
  shipName           String?                @map("ship_name")
  shipLine1          String?                @map("ship_line1")
  shipLine2          String?                @map("ship_line2")
  shipCity           String?                @map("ship_city")
  shipState          String?                @map("ship_state")
  shipPostal         String?                @map("ship_postal")
  notes              String?
  assignedToId       String?                @map("assigned_to_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  buyer              User                   @relation("CricutShopBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  assignedTo         User?                  @relation("CricutShopAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lines              CricutShopOrderLine[]

  @@index([buyerId])
  @@index([status])
  @@index([assignedToId])
  @@map("cricut_shop_orders")
}

/** Campus design ideas submitted for Cricut Club to make. */
model CricutDesignSubmission {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  submitterId    String             @map("submitter_id") @db.Uuid
  title          String
  description    String
  imageUrl       String?            @map("image_url")
  storagePath    String?            @map("storage_path")
  status         CricutDesignStatus @default(PENDING)
  reviewNote     String?            @map("review_note")
  reviewedById   String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?          @map("reviewed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submitter      User               @relation("CricutDesignSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewedBy     User?              @relation("CricutDesignReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([submitterId])
  @@index([status])
  @@map("cricut_design_submissions")
}

enum CricutProjectDifficulty {
  EASY
  MEDIUM
  ADVANCED
}

enum CricutProjectBuildIntent {
  MAKE
  SELL
}

enum CricutProjectBuildStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/** Dollar-store / cheap-creation project ideas Cricut Club can make or sell. */
model CricutProjectIdea {
  id                      String                  @id @default(cuid())
  organizationId          String                  @map("organization_id")
  slug                    String                  @unique
  title                   String
  summary                 String
  /** CricutProjectMaterial[] — name, qty, source, costCents, clubSupply. */
  materials               Json
  /** CricutProjectStep[] — title, detail. */
  steps                   Json
  estimatedCostCents      Int                     @map("estimated_cost_cents")
  suggestedSellPriceCents Int                     @map("suggested_sell_price_cents")
  imageUrl                String?                 @map("image_url")
  storagePath             String?                 @map("storage_path")
  dollarStoreTag          String?                 @map("dollar_store_tag")
  difficulty              CricutProjectDifficulty @default(EASY)
  timeMinutes             Int?                    @map("time_minutes")
  sellNotes               String?                 @map("sell_notes")
  active                  Boolean                 @default(true)
  sortOrder               Int                     @default(0) @map("sort_order")
  createdById             String?                 @map("created_by_id") @db.Uuid
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy               User?                   @relation("CricutProjectIdeaAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  builds                  CricutProjectBuild[]

  @@index([organizationId, active])
  @@index([difficulty])
  @@map("cricut_project_ideas")
}

/** A student's personal run at a project idea — materials/steps checklist. */
model CricutProjectBuild {
  id                 String                   @id @default(cuid())
  ideaId             String                   @map("idea_id")
  userId             String                   @map("user_id") @db.Uuid
  intent             CricutProjectBuildIntent @default(MAKE)
  status             CricutProjectBuildStatus @default(PLANNED)
  /** Index positions of finished steps. */
  completedSteps     Json                     @default("[]") @map("completed_steps")
  /** Index positions of gathered materials. */
  gatheredMaterials  Json                     @default("[]") @map("gathered_materials")
  notes              String?
  listedItemId       String?                  @map("listed_item_id")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  idea               CricutProjectIdea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user               User                     @relation("CricutProjectBuilder", fields: [userId], references: [id], onDelete: Cascade)
  listedItem         CricutShopItem?          @relation("CricutProjectBuildListing", fields: [listedItemId], references: [id], onDelete: SetNull)

  @@unique([ideaId, userId])
  @@index([userId, status])
  @@index([ideaId])
  @@map("cricut_project_builds")
}

model CricutShopOrderLine {
  id          String          @id @default(cuid())
  orderId     String          @map("order_id")
  itemId      String          @map("item_id")
  title       String
  unitPriceCents Int          @map("unit_price_cents")
  quantity    Int
  lineTotalCents Int          @map("line_total_cents")
  order       CricutShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        CricutShopItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([itemId])
  @@map("cricut_shop_order_lines")
}

model ClubFundraiser {
