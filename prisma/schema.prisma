  @@index([mandatoryAllClubs])
  @@map("club_calendar_events")
}

enum StudentMessageStatus {
  UNREAD
  VIEW_LATER
  DONE
  DISMISSED
}

enum StudentMessageKind {
  GENERAL
  ADVISOR_REQUEST
  INVOICE_RECEIPT_REQUEST
  CRICUT_ORDER
  BROADCAST_BOOKING
  BROADCAST_ANNOUNCEMENT_SUBMISSION
  BROADCAST_JOIN_APPLICATION
  SPORTS_COVERAGE
}

/** Advisor / officer → student Command Center messages with action buttons. */
model StudentMessage {
  id                 String               @id @default(cuid())
  fromUserId         String               @map("from_user_id") @db.Uuid
  toUserId           String               @map("to_user_id") @db.Uuid
  organizationId     String?              @map("organization_id")
  kind               StudentMessageKind   @default(GENERAL)
  title              String
  body               String?
  status             StudentMessageStatus @default(UNREAD)
  /** JSON array: [{ label, href?, actionType }] */
  actions            Json
  calendarTitle      String?              @map("calendar_title")
  calendarStart      DateTime?            @map("calendar_start")
  calendarEnd        DateTime?            @map("calendar_end")
  calendarLocation   String?              @map("calendar_location")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  fromUser           User                 @relation("StudentMessageSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser             User                 @relation("StudentMessageRecipient", fields: [toUserId], references: [id], onDelete: Cascade)
  organization       Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([toUserId, status])
  @@index([fromUserId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("student_messages")
}

enum ClubStudentTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
