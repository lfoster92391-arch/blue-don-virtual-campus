model ParentStudentLink {
  id           String   @id @default(cuid())
  parentId     String   @map("parent_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  relationship String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  parent       User     @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student      User     @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_student_links")
}

enum LunchChoiceKind {
  HOT
  VEGETARIAN
  PACKED
  NONE
}

/// One cafeteria order per diner per service date.
///
/// `dinerId` is whoever eats — a student when a parent orders for their child,
/// or the faculty member themselves when a teacher or staff member orders their
/// own lunch. `orderedById` is whoever placed it, so the office can tell a
/// parent-placed order from a self-placed one. The unique key means changing an
/// order updates the same row instead of stacking duplicates.
model LunchOrder {
  id          String          @id @default(cuid())
  dinerId     String          @map("diner_id") @db.Uuid
  orderedById String          @map("ordered_by_id") @db.Uuid
  serviceDate DateTime        @map("service_date") @db.Date
  choice      LunchChoiceKind
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  diner       User            @relation("LunchOrderDiner", fields: [dinerId], references: [id], onDelete: Cascade)
  orderedBy   User            @relation("LunchOrderPlacedBy", fields: [orderedById], references: [id], onDelete: Cascade)

  @@unique([dinerId, serviceDate])
  @@index([dinerId])
  @@index([serviceDate])
  @@index([orderedById])
  @@map("lunch_orders")
}

/// One published cafeteria menu for one calendar date.
///
/// The rotating weekday menu in `src/config/school-hub.ts` is the fallback, not
/// the source of truth: any date with a row here overrides it. A row is a draft
/// until `publishedAt` is set, so the kitchen can build three weeks out without
/// families seeing half-finished days.
model LunchMenuDay {
  id            String    @id @default(cuid())
  serviceDate   DateTime  @unique @map("service_date") @db.Date
  entree        String
  vegetarian    String
  /// Shown as a comma-joined line under the entree.
  sides         String[]  @default([])
  dessert       String?
  /// Free text for the day — "Early dismissal, cold lunch only", etc.
  note          String?
  publishedAt   DateTime? @map("published_at")
  publishedById String?   @map("published_by_id") @db.Uuid
  updatedById   String    @map("updated_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  publishedBy   User?     @relation("LunchMenuPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  updatedBy     User      @relation("LunchMenuEditor", fields: [updatedById], references: [id], onDelete: Cascade)

  @@index([serviceDate, publishedAt])
  @@map("lunch_menu_days")
}

enum DietaryRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A dietary / allergy form submitted by a parent (or the office) for a student.
///
/// This is the paper trail: it records what a family asked for and who reviewed
/// it. Accepting one copies its contents onto `StudentDietaryProfile`, which is
/// the record the rest of the app reads. Declining leaves the profile untouched.
model DietaryRequest {
  id            String               @id @default(cuid())
  studentId     String               @map("student_id") @db.Uuid
  submittedById String               @map("submitted_by_id") @db.Uuid
  status        DietaryRequestStatus @default(PENDING)
  /// Allergen ids from `DIETARY_ALLERGENS` in src/config/dietary.ts.
  allergens     String[]             @default([])
  /// Restriction ids from `DIETARY_RESTRICTIONS` in src/config/dietary.ts.
  restrictions  String[]             @default([])
  /// Family-supplied detail, e.g. "carries an EpiPen in her bag".
  notes         String?
  reviewedById  String?              @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?            @map("reviewed_at")
  reviewNote    String?              @map("review_note")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  student       User                 @relation("DietaryRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  submittedBy   User                 @relation("DietaryRequestSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy    User?                @relation("DietaryRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([submittedById])
  @@map("dietary_requests")
}

/// The canonical dietary record on a student account — one row per student.
///
/// Only an accepted `DietaryRequest` (or a direct office edit) writes here, so
/// the cafeteria and the lunch ordering board read approved facts rather than
/// whatever a family last typed into a form.
model StudentDietaryProfile {
  id              String    @id @default(cuid())
  studentId       String    @unique @map("student_id") @db.Uuid
  allergens       String[]  @default([])
  restrictions    String[]  @default([])
  notes           String?
  /// The accepted request this state came from, when it came from a form.
  sourceRequestId String?   @map("source_request_id")
  appliedById     String?   @map("applied_by_id") @db.Uuid
  appliedAt       DateTime? @map("applied_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  student         User      @relation("DietaryProfileStudent", fields: [studentId], references: [id], onDelete: Cascade)
  appliedBy       User?     @relation("DietaryProfileApplier", fields: [appliedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("student_dietary_profiles")
}

enum CafeteriaLedgerKind {
  CREDIT
  CHARGE
  ADJUSTMENT
}

/// A student's cafeteria money, kept in whole cents — one row per student.
///
/// Families pay at school in cash or by check, not in the app, so the balance
/// only ever moves when the front office records an entry. `balanceCents` is a
/// running total the ledger below has to agree with; it is stored rather than
/// summed on read so the lunch board stays a single cheap query.
model CafeteriaAccount {
  id                   String                 @id @default(cuid())
  studentId            String                 @unique @map("student_id") @db.Uuid
  balanceCents         Int                    @default(0) @map("balance_cents")
  /// When the family was last told the balance was running low, so a run of
  /// small charges does not send a message every single time.
  lowBalanceNotifiedAt DateTime?              @map("low_balance_notified_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  student              User                   @relation("CafeteriaAccountStudent", fields: [studentId], references: [id], onDelete: Cascade)
  entries              CafeteriaLedgerEntry[]

  @@map("cafeteria_accounts")
}

/// Every movement of cafeteria money, so an envelope can be traced back to the
/// person who opened it. `amountCents` is always positive; `kind` says which
/// way the balance moved. `balanceAfterCents` freezes the running total at the
/// time of the entry so a later correction cannot rewrite history.
model CafeteriaLedgerEntry {
  id                String              @id @default(cuid())
  accountId         String              @map("account_id")
  kind              CafeteriaLedgerKind
  amountCents       Int                 @map("amount_cents")
  balanceAfterCents Int                 @map("balance_after_cents")
  /// What was on the envelope, a check number, or why a balance was corrected.
  note              String?
  recordedById      String              @map("recorded_by_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")
  account           CafeteriaAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recordedBy        User                @relation("CafeteriaLedgerRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([recordedById])
  @@map("cafeteria_ledger_entries")
}

