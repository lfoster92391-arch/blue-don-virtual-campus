/**
 * Studio Bridge — the OBS control path for the Broadcast Control Studio.
 *
 * The campus runs on Vercel and cannot dial the Studio B PC through the school
 * NAT, so control is inverted: the console writes a StudioCommand row, and a
 * small agent on the OBS machine polls for it and posts telemetry back. Nothing
 * here holds an OBS password or a stream key — those live only in the agent's
 * local .env. See docs/STUDIO_BRIDGE_SETUP.md.
 */
enum StudioCommandKind {
  SET_PROGRAM_SCENE
  SET_PREVIEW_SCENE
  TRIGGER_TRANSITION
  OBS_START_STREAM
  OBS_STOP_STREAM
  OBS_START_RECORD
  OBS_STOP_RECORD
}

enum StudioCommandStatus {
  QUEUED
  CLAIMED
  DONE
  FAILED
  /** Never claimed inside its TTL — a scene taken four minutes late is worse than not taken. */
  EXPIRED
}

/**
 * One OBS machine paired to the campus. Holds the newest telemetry snapshot the
 * agent posted; liveness is derived from `lastSeenAt`, never from a stored
 * "connected" flag, so a bridge that dies mid-show reads DISCONNECTED.
 */
model StudioBridge {
  id    String @id @default(cuid())
  /** Stable device key from the agent's env, e.g. `studio-b`. */
  key   String @unique
  label String

  /** SHA-256 of the shared bridge token this device last authenticated with. Never the token itself. */
  tokenHash String? @map("token_hash")

  lastSeenAt DateTime? @map("last_seen_at")
  agentVersion String? @map("agent_version")

  obsConnected      Boolean @default(false) @map("obs_connected")
  obsVersion        String? @map("obs_version")
  studioModeEnabled Boolean @default(false) @map("studio_mode_enabled")
  programScene      String? @map("program_scene")
  previewScene      String? @map("preview_scene")
  /** Scene names read from OBS (string[]). Empty until the agent reports. */
  scenes            Json    @default("[]")
  streaming         Boolean @default(false)
  recording         Boolean @default(false)
  streamTimecode    String? @map("stream_timecode")
  recordTimecode    String? @map("record_timecode")
  /** Encoder counters straight from OBS GetStats — kbps, dropped frames, cpu. */
  stats             Json?

  lastError   String?   @map("last_error")
  lastErrorAt DateTime? @map("last_error_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions StudioSession[]
  commands StudioCommand[]

  @@map("studio_bridges")
}

/** One agent run (process lifetime), so "was the bridge up for the game?" is answerable. */
model StudioSession {
  id       String @id @default(cuid())
  bridgeId String @map("bridge_id")
  /** Run id the agent generates at startup; a new one means the agent restarted. */
  runId    String @map("run_id")

  startedAt    DateTime  @default(now()) @map("started_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  endedAt      DateTime? @map("ended_at")
  agentVersion String?   @map("agent_version")
  obsVersion   String?   @map("obs_version")

  bridge   StudioBridge    @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  commands StudioCommand[]

  @@unique([bridgeId, runId])
  @@index([bridgeId, startedAt])
  @@map("studio_sessions")
}

/**
 * Queued OBS action. `kind` is an enum, so the database itself cannot hold an
 * arbitrary OBS RPC; the agent whitelists the same set again before calling OBS.
 */
model StudioCommand {
  id        String              @id @default(cuid())
  bridgeId  String              @map("bridge_id")
  sessionId String?             @map("session_id")
  kind      StudioCommandKind
  /** Narrow, kind-specific arguments — `{ sceneName }` at most. */
  payload   Json                @default("{}")
  status    StudioCommandStatus @default(QUEUED)

  requestedById   String? @map("requested_by_id") @db.Uuid
  requestedByName String? @map("requested_by_name")

  claimedAt   DateTime? @map("claimed_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime  @map("expires_at")
  error       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bridge      StudioBridge   @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  session     StudioSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  requestedBy User?          @relation("StudioCommandRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([bridgeId, status, createdAt])
  @@index([requestedById])
  @@map("studio_commands")
}

/**
 * On-air graphics for the Broadcast Control Studio (Phase 6).
 *
 * The overlay is an OBS Browser Source pointed at an unauthenticated page, so
 * the only thing these tables may ever hold is copy that is already public on
 * the campus sports surfaces. No stream keys, no OBS passwords, no PII.
 */
enum StudioGraphicKind {
  LOWER_THIRD
  PLAYER_ID
  SCORE_BUG
  LINEUP
  GAME_ANNOUNCEMENT
  FINAL_SCORE
  ANNOUNCEMENT
  SPONSOR
  /** Full-frame sponsor billboard, for breaks rather than under a talking head. */
  SPONSOR_FULL
}

enum StudioGraphicState {
  /** Cued on the console only. The overlay never renders a PREVIEW row. */
  PREVIEW
  LIVE
  CLEARED
}

/**
 * One overlay surface — the Browser Source URL a studio machine loads.
 *
 * `sessionKey` is the long unguessable segment in that URL. The page is
 * necessarily unauthenticated (OBS cannot log in), so the key is the only gate
 * and can be rotated from the console. `lastSeenAt` is written by the overlay's
 * own polling, so "browser source attached" is measured, never assumed.
 */
model StudioOverlay {
  id         String    @id @default(cuid())
  /** Stable channel key, e.g. `studio-b`. Not a secret. */
  key        String    @unique
  label      String
  sessionKey String    @unique @map("session_key")
  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  graphics StudioGraphic[]

  @@map("studio_overlays")
}

/**
 * The active graphic of each kind on one overlay — at most eight rows per
 * surface, not a graphics CMS. Editable copy lives in `fields`; the score,
 * lineup, and final-score cards keep a `gameId` instead of a copied score, so
 * the overlay renders the same `SportsGame` row the campus reads.
 */
model StudioGraphic {
  id        String             @id @default(cuid())
  overlayId String             @map("overlay_id")
  kind      StudioGraphicKind
  state     StudioGraphicState @default(PREVIEW)
  /** Narrow display copy: title, subtitle, detail, note, and lineup rows. */
  fields    Json               @default("{}")

  gameId   String? @map("game_id")
  playerId String? @map("player_id")
  /** Sponsor cards keep the row, not a copy of its name and logo. */
  sponsorId String? @map("sponsor_id")

  takenAt   DateTime? @map("taken_at")
  clearedAt DateTime? @map("cleared_at")

  updatedById   String? @map("updated_by_id") @db.Uuid
  updatedByName String? @map("updated_by_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  overlay   StudioOverlay  @relation(fields: [overlayId], references: [id], onDelete: Cascade)
  game      SportsGame?    @relation("StudioGraphicGame", fields: [gameId], references: [id], onDelete: SetNull)
  player    SportsPlayer?  @relation("StudioGraphicPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  sponsor   StudioSponsor? @relation("StudioGraphicSponsor", fields: [sponsorId], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("StudioGraphicOperator", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([overlayId, kind])
  @@index([overlayId, state])
  @@index([gameId])
  @@index([sponsorId])
  @@map("studio_graphics")
}

/**
 * A sponsor the broadcast can put on air (Phase 7).
 *
 * The campus `Partner` directory stays the record of who the school works
 * with; `partnerId` adopts one of those rows so a name and logo are entered
 * once. What lives here is only what a broadcast needs and a directory does
 * not have: rotation order, how long a billboard sits, and whether the sponsor
 * is in tonight's book. Read by the public overlay, so nothing but public
 * marketing copy may ever land in these columns.
 */
model StudioSponsor {
  id      String  @id @default(cuid())
  name    String
  tagline String?
  /** Absolute http(s) URL. Validated on write; rendered on the public overlay. */
  logoUrl String? @map("logo_url")

  partnerId String? @map("partner_id")

  /** Seconds a billboard is meant to sit before the next sponsor. */
  durationSeconds Int     @default(15) @map("duration_seconds")
  /** Rotation order — lower goes first, then name. */
  priority        Int     @default(0)
  isActive        Boolean @default(true) @map("is_active")

  /** Last time this sponsor was taken to air. Ordering aid, not an impression count. */
  lastLiveAt DateTime? @map("last_live_at")

  updatedById   String? @map("updated_by_id") @db.Uuid
  updatedByName String? @map("updated_by_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner   Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("StudioSponsorOperator", fields: [updatedById], references: [id], onDelete: SetNull)
  graphics  StudioGraphic[] @relation("StudioGraphicSponsor")

  @@index([isActive, priority])
  @@index([partnerId])
  @@map("studio_sponsors")
}

/**
 * Where the operator is in today's rundown (Phase 7).
 *
 * Progress only — never the script. Items are referenced by the slot keys in
 * `BroadcastScriptTemplate` / `BroadcastDailyScript`, so the words an operator
 * reads keep exactly one home and this row cannot drift from them. A slot that
 * disappears from the template simply stops being referenced.
 */
model StudioRunOfShow {
  id  String @id @default(cuid())
  /** Studio surface the progress belongs to, e.g. `studio-b`. */
  key String
  /** UTC day, matching `BroadcastDailyScript.scriptDate`. */
  showDate DateTime @map("show_date") @db.Date

  /** Slot key that is on the air, or null before the show starts. */
  currentKey String? @map("current_key")
  /** Slot key → `READY` / `COMPLETED` / `SKIPPED`. Absent means pending. */
  itemStates Json    @default("{}") @map("item_states")

  startedAt DateTime? @map("started_at")
  /** When the current item was taken — what the segment timer counts from. */
  itemStartedAt DateTime? @map("item_started_at")
  endedAt       DateTime? @map("ended_at")

  updatedById   String? @map("updated_by_id") @db.Uuid
  updatedByName String? @map("updated_by_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("StudioRunOfShowOperator", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([key, showDate])
  @@map("studio_run_of_show")
}

