model BroadcastAnnouncement {
  id               String           @id @default(cuid())
  announcementDate DateTime         @map("announcement_date") @db.Date
  title            String
  body             String
  authorId         String           @map("author_id") @db.Uuid
  mediaItemId      String?          @map("media_item_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  author           User             @relation("BroadcastAnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mediaItem        CampusMediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: SetNull)

  @@unique([announcementDate])
  @@index([announcementDate])
  @@index([authorId])
  @@index([mediaItemId])
  @@map("broadcast_announcements")
}

/**
 * Org-level Show Script slot structure (advisor-editable).
 * slots JSON: BroadcastScriptSlotDef[]
 */
model BroadcastScriptTemplate {
  id             String       @id @default(cuid())
  organizationId String       @unique @map("organization_id")
  slots          Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("broadcast_script_templates")
}

/**
 * Shared daily rundown for the broadcast team (one script per org per day).
 * values JSON: Record<slotKey, string> for STUDENT_FILL slots.
 * prayerText is the LOCKED_DAILY school prayer for that day.
 */
model BroadcastDailyScript {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  scriptDate     DateTime     @map("script_date") @db.Date
  prayerText     String?      @map("prayer_text")
  values         Json         @default("{}")
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy      User?        @relation("BroadcastDailyScriptUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, scriptDate])
  @@index([organizationId, scriptDate])
  @@index([updatedById])
  @@map("broadcast_daily_scripts")
}

enum CornerStoreStatus {
  ACTIVE
  SOLD
  DRAFT
  REMOVED
}

enum ClubLedgerEntryType {
  DEPOSIT
  WITHDRAWAL
}

enum ClubFundraiserStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model ClubLedgerEntry {
  id            String              @id @default(cuid())
  organizationId String             @map("organization_id")
  type          ClubLedgerEntryType
  amountCents   Int                 @map("amount_cents")
  memo          String?
  fundraiserId  String?             @map("fundraiser_id")
  invoiceId     String?             @unique @map("invoice_id")
  receiptUrl    String?             @map("receipt_url")
  createdById   String              @map("created_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundraiser    ClubFundraiser?     @relation(fields: [fundraiserId], references: [id], onDelete: SetNull)
  invoice       ClubInvoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy     User                @relation("ClubLedgerCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([fundraiserId])
  @@index([createdById])
  @@map("club_ledger_entries")
}

enum ClubInvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}

/** Expense / invoice submission with materials line items + receipt scan. */
model ClubInvoice {
  id                 String            @id @default(cuid())
  organizationId     String            @map("organization_id")
  vendor             String
  invoiceDate        DateTime          @map("invoice_date")
  totalCents         Int               @map("total_cents")
  memo               String?
  receiptUrl         String?           @map("receipt_url")
  receiptStoragePath String?           @map("receipt_storage_path")
  status             ClubInvoiceStatus @default(PENDING)
  submittedById      String            @map("submitted_by_id") @db.Uuid
  reviewedById       String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?         @map("reviewed_at")
  reviewNote         String?           @map("review_note")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy        User              @relation("ClubInvoiceSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy         User?             @relation("ClubInvoiceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  lines              ClubInvoiceLine[]
  ledgerEntry        ClubLedgerEntry?

  @@index([organizationId, status])
  @@index([submittedById])
  @@index([status])
  @@map("club_invoices")
}

model ClubInvoiceLine {
  id            String      @id @default(cuid())
  invoiceId     String      @map("invoice_id")
  description   String
  quantity      Decimal     @db.Decimal(12, 3)
  unitCostCents Int         @map("unit_cost_cents")
  lineTotalCents Int        @map("line_total_cents")
  sortOrder     Int         @default(0) @map("sort_order")
  invoice       ClubInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("club_invoice_lines")
}

enum CricutShopItemStatus {
  ACTIVE
  SOLD
  DRAFT
  REMOVED
}

enum CricutFulfillmentMethod {
  PICKUP
  SHIP
}

enum CricutShopOrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

/** Cricut Club branded merch / maker shop listings. */
model CricutShopItem {
  id             String               @id @default(cuid())
  title          String
  description    String?
  priceCents     Int                  @map("price_cents")
  imageUrl       String?              @map("image_url")
  storagePath    String?              @map("storage_path")
  status         CricutShopItemStatus @default(ACTIVE)
  sellerId       String               @map("seller_id") @db.Uuid
  organizationId String               @map("organization_id")
  inventoryQty   Int?                 @map("inventory_qty")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  seller         User                 @relation("CricutShopSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderLines     CricutShopOrderLine[]

  @@index([status])
  @@index([organizationId])
  @@index([sellerId])
  @@map("cricut_shop_items")
}

model CricutShopOrder {
  id                 String                 @id @default(cuid())
  buyerId            String                 @map("buyer_id") @db.Uuid
  fulfillment        CricutFulfillmentMethod
  status             CricutShopOrderStatus  @default(PENDING)
  subtotalCents      Int                    @map("subtotal_cents")
  shippingCents      Int                    @default(0) @map("shipping_cents")
  totalCents         Int                    @map("total_cents")
  shipName           String?                @map("ship_name")
  shipLine1          String?                @map("ship_line1")
  shipLine2          String?                @map("ship_line2")
  shipCity           String?                @map("ship_city")
  shipState          String?                @map("ship_state")
  shipPostal         String?                @map("ship_postal")
  notes              String?
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  buyer              User                   @relation("CricutShopBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  lines              CricutShopOrderLine[]

  @@index([buyerId])
  @@index([status])
  @@map("cricut_shop_orders")
}

model CricutShopOrderLine {
  id          String          @id @default(cuid())
  orderId     String          @map("order_id")
  itemId      String          @map("item_id")
  title       String
  unitPriceCents Int          @map("unit_price_cents")
  quantity    Int
  lineTotalCents Int          @map("line_total_cents")
  order       CricutShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        CricutShopItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([itemId])
  @@map("cricut_shop_order_lines")
}

model ClubFundraiser {
