# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Focused clubs mode — default ON in app (src/config/app-mode.ts).
# Set to 0 / false to restore full campus nav. See docs/CLUB_FOCUS_PIVOT.md.
# BLUE_DON_FOCUSED_CLUBS=0

# Local/demo auth bypass (development only — see docs/TEST_ACCOUNTS.md)
# Comma-separated emails that may register/sign in without @weirtonmadonna.org.
# NEXT_PUBLIC_ mirror is required for client-side registration validation.
AUTH_TEST_BYPASS_EMAILS=demo.student@bluedon.test,demo.teacher@bluedon.test
NEXT_PUBLIC_AUTH_TEST_BYPASS_EMAILS=demo.student@bluedon.test,demo.teacher@bluedon.test
# ALLOW_AUTH_TEST_BYPASS=true

# Asset Pilot EDU partner integration (optional)
# NEXT_PUBLIC_PARTNER_SITE_URL=https://www.assetpilotedu.com
# ASSETPILOT_SITE_URL=https://www.assetpilotedu.com

# Asset Pilot EDU integration (optional — see docs/ASSETPILOT_INTEGRATION.md)
# ASSETPILOT_SITE_URL=https://assetpilotedu.com

# IT Help Desk (Spiceworks) — student and staff technology support requests
NEXT_PUBLIC_IT_HELP_DESK_EMAIL=help@weirtonmadonna.on.spiceworks.com
IT_HELP_DESK_EMAIL=help@weirtonmadonna.on.spiceworks.com

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/blue_don_virtual_campus

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for admin account management: creating student logins at
# /admin/students, and role changes + password resets at /admin/users. Without it
# those actions fail with "Account creation is unavailable." Never expose this key
# to the client. Find it in the Supabase dashboard under Project Settings → API →
# service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Campus media uploads (create a public bucket in Supabase Storage)
# SUPABASE_CAMPUS_MEDIA_BUCKET=campus-media
# BLUE_DON_LIVE_RTMP_URL=rtmp://live.bluedon.madonna.edu/app

# Studio Bridge — OBS control for the Broadcast Control Studio.
# Shared secret between this server and the agent on the Studio B PC. Server-only
# and never NEXT_PUBLIC_: the browser never sees it, and it is compared in
# constant time. Only a SHA-256 of it is stored in the database (StudioBridge.
# tokenHash) so the plaintext lives nowhere but the two environments.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be at least 24 characters, or the bridge routes report "not configured".
# Setup guide: docs/STUDIO_BRIDGE_SETUP.md
# STUDIO_BRIDGE_TOKEN=

# Analytics (Phase 11+)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Monitoring (Phase 11+)
# SENTRY_DSN=
