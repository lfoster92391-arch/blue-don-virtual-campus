# Blue Don Studio Bridge — Studio B PC only.
# Copy to .env in this folder. Never commit the filled-in file, and never put
# any of these values into the campus site's environment.

# OBS → Tools → WebSocket Server Settings → Show Connect Info
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=paste-the-obs-websocket-password

# The campus site. Production: https://campus.assetpilotedu.com
STUDIO_API_URL=https://campus.assetpilotedu.com

# Must match STUDIO_BRIDGE_TOKEN in the campus (Vercel) environment, exactly.
STUDIO_BRIDGE_TOKEN=paste-the-shared-bridge-token

# Device name for this machine. Leave as studio-b unless a second OBS PC is added.
STUDIO_BRIDGE_KEY=studio-b

# Timings. Defaults are fine; raise the poll interval only if the PC is loaded.
# STUDIO_BRIDGE_POLL_MS=3000
# STUDIO_BRIDGE_HEARTBEAT_MS=10000
# STUDIO_BRIDGE_TIMEOUT_MS=8000
